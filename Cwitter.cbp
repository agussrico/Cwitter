<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Cwitter" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/Cwitter" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/Cwitter" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="include" />
			<Add directory="C:/libs/curl/include" />
		</Compiler>
		<Linker>
			<Add library="curl" />
			<Add directory="C:/libs/curl/lib" />
		</Linker>
		<Unit filename="include/arbol.h" />
		<Unit filename="include/cJSON.h" />
		<Unit filename="include/famecheck.h" />
		<Unit filename="include/indice.h" />
		<Unit filename="include/lista.h" />
		<Unit filename="include/tweet.h" />
		<Unit filename="include/user.h" />
		<Unit filename="src/arbol.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/cJSON.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/famecheck.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/indice.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/lista.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/tweet.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/user.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions />
	</Project>
</CodeBlocks_project_file>
